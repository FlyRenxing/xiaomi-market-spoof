<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">小米应用商店伪装</string>
    <string name="xposed_description">仅在小米应用商店进程内，将机型伪装为小米 18 Pro Max（madrid / 2611FPNFAG），避免商店按型号限制下载速度。不修改全局系统属性。</string>
    <string name="section_identity">伪装身份</string>
    <string name="label_manufacturer">厂商 / 品牌</string>
    <string name="label_device">设备代号</string>
    <string name="label_model">型号</string>
    <string name="section_problem">解决什么问题</string>
    <string name="problem_title">按机型限速</string>
    <string name="problem_body">小米应用商店会按机型控制下载管理器是否限速。本模块只在商店进程内，把可见机型改成小米 18 Pro Max，从而避开按型号下发的限速。</string>
    <string name="section_usage">使用方法</string>
    <string name="usage_step_1_title">1. 启用模块</string>
    <string name="usage_step_1">在 LSPosed 中启用本模块</string>
    <string name="usage_step_2_title">2. 勾选作用域</string>
    <string name="usage_step_2">作用域只勾选「小米应用商店」</string>
    <string name="usage_step_3_title">3. 强行停止</string>
    <string name="usage_step_3">强行停止小米应用商店</string>
    <string name="usage_step_4_title">4. 重新下载</string>
    <string name="usage_step_4">重新打开商店后再下载</string>
    <string name="section_note">说明</string>
    <string name="note_title">只改商店进程</string>
    <string name="note_body">不会修改全局 getprop，其他应用仍看到真实机型。也不会改指纹或 MIUI 版本号。</string>
</resources>
